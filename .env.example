# Unified API Service 环境变量配置
# 复制此文件为 .env 并填入真实值

# ==================== 应用配置 ====================
APP_NAME=Unified_API_Service
APP_VERSION=0.1.0
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ==================== DeepSeek API 配置 ====================
# 文档/RAG 问答必须使用真实 LLM；mock 仅用于本地寒暄/单元测试
DEEPSEEK_API_KEY=sk-512e3b5509f845ec8fc4944eae3348df
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=30
LLM_PROVIDER=deepseek  # 生产和正常文档问答使用 deepseek；mock 仅用于本地调试

# ==================== Chroma 向量数据库配置 ====================
# 阶段3启用
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ==================== Redis 配置 ====================
# 生产环境用于飞书文件确认 pending 状态和公开入口限流；不可用时会回退本机内存
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=unified_rag
REDIS_SOCKET_TIMEOUT=5
REDIS_CONNECT_TIMEOUT=5
REDIS_HEALTH_CHECK_INTERVAL=30
REDIS_RETRY_COOLDOWN_SECONDS=10
# Docker Compose 内部运行时使用：REDIS_URL=redis://redis:6379/0

# ==================== Serper 搜索配置 ====================
# 阶段5启用
SERPER_API_KEY=1adbc5bfe2b5d412df7c50f72b156282fe7bd878
SERPER_URL=https://google.serper.dev/search
SEARCH_TIMEOUT=10
MAX_RETRIES=2

# ==================== 文档处理配置 ====================
# 阶段3启用
UPLOAD_DIR=./data/uploads
CHUNK_SIZE=500
CHUNK_OVERLAP=50
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# ==================== 会话配置 ====================
# 阶段4启用
MEMORY_WINDOW_MESSAGES=6
MEMORY_MAX_MESSAGES=20
MEMORY_SESSION_TTL_SECONDS=604800
RECENT_ANSWER_REUSE_SIMILARITY_THRESHOLD=0.8
RECENT_ANSWER_REUSE_MIN_CHARS=6

# ==================== 检索配置 ====================
# 阶段3启用
TOP_K=5
BM25_TOP_K=3
HYBRID_VECTOR_WEIGHT=0.7
HYBRID_BM25_WEIGHT=0.3
GLOBAL_MAX_CHUNKS=50
OPENSEARCH_ENABLED=false
OPENSEARCH_URL=http://localhost:9201
OPENSEARCH_INDEX_NAME=unified_kb_chunks
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_TIMEOUT_SECONDS=3
OPENSEARCH_LEXICAL_TOP_K=80
OPENSEARCH_RRF_K=60
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_USE_IK_ANALYZER=true

# ==================== 飞书配置 ====================
# 阶段6启用
# HTTP 回调：开放平台选择“将事件发送至开发者服务器”，URL=/channels/feishu/events
# 长连接备用：开放平台选择“使用长连接接收事件”，启动：
# /root/.venvs/unified_api_service/bin/python -m app.channels.feishu_ws_worker
FEISHU_APP_ID=cli_aa92b248a37a9cdc
FEISHU_APP_SECRET=jGQTlZjhL6dFjTTXKxLJ6gV6ihA7cOfD
FEISHU_VERIFICATION_TOKEN=c0ZpiAGRhnO0ivjnMH0JYeaXUK7ewFZ6
FEISHU_ENCRYPT_KEY=Ll28x8w4Dy6DlB01YdksveWsggUJDseu
FEISHU_LINK_READ_ENABLED=true
FEISHU_LINK_MAX_COUNT=3
FEISHU_RESOURCE_MAX_CHARS=12000
FEISHU_SHEET_SAMPLE_ROWS=30
FEISHU_BITABLE_SAMPLE_RECORDS=50

# ==================== 文档 MCP 后端配置 ====================
# DOCX/XLSX 编辑依赖独立的 MCP HTTP 服务。服务必须与 API 服务共享同一文件系统挂载
# （或等价的网络文件系统），因为文件路径在 API 服务和 MCP 服务之间直接传递。
#
# TXT/PDF 使用本地后端，无需额外配置。
#
# 启用 MCP 后端：
#   DOCUMENT_MCP_ENABLED=true
#   DOCUMENT_MCP_TIMEOUT_SECONDS=30
#
# DOCX MCP 服务地址（启用时必填）：
#   DOCX_MCP_BASE_URL=http://localhost:9100
#
# XLSX MCP 服务地址（启用时必填）：
#   XLSX_MCP_BASE_URL=http://localhost:9101
#
# MCP 服务 HTTP 契约：
#   POST {base_url}/docx/read_structure   → {file_path: str}
#   POST {base_url}/docx/read_paragraph   → {file_path: str, index: int}
#   POST {base_url}/docx/replace_paragraph → {file_path: str, index: int, new_text: str}
#   POST {base_url}/docx/delete_paragraph  → {file_path: str, index: int}
#   POST {base_url}/docx/append_paragraph  → {file_path: str, text: str}
#   POST {base_url}/docx/save_copy         → {file_path: str, output_path: str}
#   POST {base_url}/xlsx/read_structure    → {file_path: str}
#   POST {base_url}/xlsx/read_cell         → {file_path: str, sheet: str, cell: str}
#   POST {base_url}/xlsx/modify_cell       → {file_path: str, sheet: str, cell: str, value: str}
#   POST {base_url}/xlsx/append_row        → {file_path: str, sheet: str, values: list[str]}
#   POST {base_url}/xlsx/delete_row        → {file_path: str, sheet: str, row: int}
#   POST {base_url}/xlsx/save_copy          → {file_path: str, output_path: str}
#
# 所有响应格式：{success: bool, data?: object, error?: string}
DOCUMENT_MCP_ENABLED=false
DOCUMENT_MCP_TIMEOUT_SECONDS=30
DOCX_MCP_BASE_URL=
XLSX_MCP_BASE_URL=

# ==================== 安全配置 ====================
# 阶段7启用
# /ask 和 /documents/upload 生产环境必须配置 API_KEY。调用方需要传：
# Authorization: Bearer your_api_key_here
# X-User-Id: 当前可信用户ID
# X-Channel: api
API_KEY=your_api_key_here
JWT_SECRET=your_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOWED_METHODS=GET,POST,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-API-Key,X-User-Id,X-Channel

# ==================== 限流配置 ====================
# 覆盖 /ask、/documents/upload 和 /channels/feishu/events
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=./logs/app.log
