# Unified API Service 环境变量配置
# 复制此文件为 .env 并填入真实值

# ==================== 应用配置 ====================
APP_NAME=Unified_API_Service
APP_VERSION=0.1.0
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ==================== DeepSeek API 配置 ====================
# 阶段2启用，阶段1使用mock
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=30
LLM_PROVIDER=mock  # mock 或 deepseek

# ==================== Chroma 向量数据库配置 ====================
# 阶段3启用
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ==================== Redis 配置 ====================
# 阶段4启用
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=unified_rag
REDIS_SOCKET_TIMEOUT=5

# ==================== Serper 搜索配置 ====================
# 阶段5启用
SERPER_API_KEY=your_serper_api_key_here
SERPER_URL=https://google.serper.dev/search
SEARCH_TIMEOUT=10
MAX_RETRIES=2

# ==================== 文档处理配置 ====================
# 阶段3启用
UPLOAD_DIR=./data/uploads
CHUNK_SIZE=500
CHUNK_OVERLAP=50
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# ==================== 会话配置 ====================
# 阶段4启用
MEMORY_WINDOW_MESSAGES=6
MEMORY_MAX_MESSAGES=20

# ==================== 检索配置 ====================
# 阶段3启用
TOP_K=5
BM25_TOP_K=3
HYBRID_VECTOR_WEIGHT=0.7
HYBRID_BM25_WEIGHT=0.3
GLOBAL_MAX_CHUNKS=50
OPENSEARCH_ENABLED=false
OPENSEARCH_URL=http://localhost:9201
OPENSEARCH_INDEX_NAME=unified_kb_chunks
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_TIMEOUT_SECONDS=3
OPENSEARCH_LEXICAL_TOP_K=80
OPENSEARCH_RRF_K=60
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_USE_IK_ANALYZER=true

# ==================== 飞书配置 ====================
# 阶段6启用
FEISHU_APP_ID=your_feishu_app_id
FEISHU_APP_SECRET=your_feishu_app_secret
FEISHU_VERIFICATION_TOKEN=your_verification_token
FEISHU_ENCRYPT_KEY=your_encrypt_key

# ==================== 安全配置 ====================
# 阶段7启用
API_KEY=your_api_key_here
JWT_SECRET=your_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# ==================== 限流配置 ====================
# 阶段7启用
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=./logs/app.log
